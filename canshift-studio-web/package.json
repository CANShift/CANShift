{
  "name": "canshift-studio-web",
  "version": "0.0.0-spike",
  "private": true,
  "type": "module",
  "description": "Phase-1 spike: dash-hosted Studio renderer (issue #1104).",
  "scripts": {
    "predev": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && npm run tokens:gen",
    "dev": "vite",
    "dev:mock": "node scripts/mock-ws.mjs",
    "prebuild": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && npm run tokens:gen",
    "build": "vite build && npm run gzip:dist",
    "gzip:dist": "node scripts/gzip-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:gen": "node scripts/generate-tokens.css.mjs",
    "size:report": "node scripts/report-bundle-size.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tmbk/canshift-core": "file:../canshift-core",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "ws": "^8.18.0"
  }
}
