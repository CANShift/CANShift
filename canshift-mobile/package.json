{
  "name": "canshift-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "prepare": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build",
    "lint": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && eslint .",
    "typecheck": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && tsc --noEmit",
    "test": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && jest",
    "test:coverage": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preinstall": "node ./scripts/check-overrides.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@tmbk/canshift-core": "file:../canshift-core",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.16",
    "expo-file-system": "~55.0.22",
    "expo-location": "~55.1.10",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.16",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.83.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "//overrides": "Carried-over CVE pins. Expo SDK 55 no longer ships `tar` as a dep nor pulls `@xmldom/xmldom` through `@expo/plist` (verified via `npm ls`), so the SDK 52-era pins on those two packages have been dropped. `scripts/check-overrides.js` still guards against `tar@>=7` and `@xmldom/xmldom@>=0.9` reintroduction (cheap, leaves a paper trail if a future Expo bump regresses).",
  "overrides": {
    "uuid": "^11.1.0",
    "postcss": "^8.5.3",
    "markdown-it": ">=12.3.2",
    "@tootallnate/once": ">=3.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "buffer",
          "clsx"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
