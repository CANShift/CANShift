{
  "name": "canshift-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "prepare": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build",
    "lint": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && eslint .",
    "typecheck": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && tsc --noEmit",
    "test": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && jest",
    "test:coverage": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preinstall": "node ./scripts/check-overrides.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@tmbk/canshift-core": "file:../canshift-core",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-location": "~18.1.6",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.79.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "//overrides": "scripts/check-overrides.js blocks tar>=7 and @xmldom/xmldom>=0.9. Re-evaluate these blocks against the SDK 53 @expo/cli internals; remove if the constraints no longer apply. The 0.8.13 xmldom pin is the LTS line and patches all known CVEs (issue #588).",
  "overrides": {
    "uuid": "^11.1.0",
    "postcss": "^8.5.3",
    "@xmldom/xmldom": "0.8.13",
    "markdown-it": ">=12.3.2",
    "@tootallnate/once": ">=3.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "buffer",
          "clsx",
          "react-native-markdown-display"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
