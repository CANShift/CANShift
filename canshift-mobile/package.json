{
  "name": "canshift-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "preinstall": "node -e \"const p=require('./package.json');const o=p.overrides||{};const banned={tar:'tar v7 breaks Expo prebuild (Cannot read properties of undefined reading extract)','@xmldom/xmldom':'xmldom v0.9 breaks @expo/plist parseFromString (mimeType undefined)'};const hit=Object.keys(banned).find(k=>o[k]);if(hit){console.error('\\n[canshift-mobile] ERROR: incompatible override re-introduced: '+hit+'\\n'+banned[hit]+'\\nRemove overrides.'+hit+' from package.json before reinstalling.\\n');process.exit(1);}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/slider": "4.5.5",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~52.0.0",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-network": "~7.0.5",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-hook-form": "^7.75.0",
    "react-native": "0.76.9",
    "react-native-ble-plx": "^3.5.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "^2.3.3",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "//overrides": "Do NOT add 'tar' (>=7) or '@xmldom/xmldom' (>=0.9) here. Both break Expo SDK 52 internals (tar.extract undefined / DOMParser.parseFromString mimeType undefined). The preinstall script blocks them.",
  "overrides": {
    "uuid": "^11.1.0",
    "postcss": "^8.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
