{
  "expo": {
    "name": "CANShift",
    "slug": "canshift-mobile",
    "version": "0.1.0",
    "scheme": "canshift",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#201E1D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.tmbk.canshift",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CANShift uses Bluetooth to connect to the dashboard device for live data and configuration."
      }
    },
    "android": {
      "package": "ch.tmbk.canshift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#201E1D"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withGlogFmtFix",
      "./plugins/withSilencePodsWarnings",
      "./plugins/withBluetoothScanNeverForLocation",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "CANShift uses Bluetooth to connect to the dashboard device for live data and configuration."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CANShift uses your location to record laps and detect start/finish crossings on the circuit."
        }
      ]
    ]
  }
}
