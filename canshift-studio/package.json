{
  "name": "canshift-studio",
  "version": "0.10.0",
  "description": "CANShift Desktop Configuration Studio — visual dashboard editor for CANShift firmware",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && npm run tokens:gen",
    "dev": "electron-vite dev",
    "prebuild": "npm --prefix ../canshift-core ci --omit=dev --ignore-scripts && npm --prefix ../canshift-core run build && npm run tokens:gen",
    "build": "electron-vite build",
    "tokens:gen": "node scripts/generate-tokens.css.mjs",
    "analyze": "ANALYZE=1 electron-vite build",
    "size:check": "node scripts/check-renderer-size.mjs",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src main && npm run lint:no-unsafe-html",
    "lint:fix": "eslint src main --fix",
    "lint:no-unsafe-html": "if grep -RIn --include='*.ts' --include='*.tsx' -E '(^|[^/*]\\s)dangerouslySetInnerHTML\\s*[=:]|(^|[^/*]\\s)\\.innerHTML\\s*=' src main; then echo 'Unsafe HTML sink found — refuse XSS surface (issue #240).' >&2; exit 1; fi",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"main/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"main/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "canshift",
    "dashboard",
    "esp32",
    "can-bus",
    "electron"
  ],
  "author": "TMBK",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tmbk/canshift-core": "file:../canshift-core",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "esptool-js": "^0.6.0",
    "fast-deep-equal": "^3.1.3",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "serialport": "^12.0.0",
    "sonner": "^2.0.7",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/spark-md5": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.14",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "ch.tmbk.canshift.studio",
    "productName": "CS Studio",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "tburkhalterr",
      "repo": "CANShift",
      "releaseType": "draft"
    }
  }
}
