{
  "name": "canshift-studio",
  "version": "0.4.1",
  "description": "CANShift Desktop Configuration Studio — visual dashboard editor for CANShift firmware",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src main",
    "lint:fix": "eslint src main --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"main/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"main/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "canshift",
    "dashboard",
    "esp32",
    "can-bus",
    "electron"
  ],
  "author": "TMBK",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@tmbk/canshift-core": "file:../canshift-core",
    "electron-updater": "^6.8.3",
    "esptool-js": "^0.4.3",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "serialport": "^12.0.0",
    "spark-md5": "^3.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/spark-md5": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "ch.tmbk.canshift.studio",
    "productName": "CS Studio",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../canshift-firmware/sd_contents",
        "to": "sd_contents",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "tburkhalterr",
      "repo": "CANShift",
      "releaseType": "draft"
    }
  }
}
