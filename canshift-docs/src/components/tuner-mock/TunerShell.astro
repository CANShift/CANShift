---
type RouteKey =
  | "welcome"
  | "dashboard"
  | "can"
  | "ecu"
  | "obd2"
  | "themes"
  | "live"
  | "logs"
  | "cli"
  | "firmware"
  | "about";

type Status = "connected" | "disconnected" | "connecting" | "simulation";

interface Props {
  route: RouteKey;
  status?: Status;
  port?: string;
  firmwareVersion?: string;
  tunerVersion?: string;
}

const {
  route,
  status = "connected",
  port = "303a:1001",
  firmwareVersion = "0.42.0",
  tunerVersion = "0.42.0",
} = Astro.props;

type Entry =
  | { kind: "item"; to: RouteKey; label: string; icon: string }
  | { kind: "divider" };

const ENTRIES: Entry[] = [
  { kind: "item", to: "welcome", label: "Welcome", icon: "⚡" },
  { kind: "divider" },
  { kind: "item", to: "dashboard", label: "Dashboard", icon: "◉" },
  { kind: "item", to: "can", label: "CAN Bus", icon: "⇄" },
  { kind: "item", to: "ecu", label: "ECU Profile", icon: "⚛" },
  { kind: "item", to: "obd2", label: "OBD-II", icon: "⚙" },
  { kind: "item", to: "themes", label: "Themes", icon: "◐" },
  { kind: "divider" },
  { kind: "item", to: "live", label: "Live Data", icon: "▤" },
  { kind: "item", to: "logs", label: "Logs", icon: "☰" },
  { kind: "item", to: "cli", label: "CLI", icon: "›_" },
  { kind: "divider" },
  { kind: "item", to: "firmware", label: "Firmware", icon: "⏏" },
  { kind: "item", to: "about", label: "About", icon: "ⓘ" },
];

const STATUS_VISUAL: Record<Status, { color: string; label: string }> = {
  connected: { color: "var(--cs-success)", label: "Connected" },
  connecting: { color: "var(--cs-accent)", label: "Connecting…" },
  disconnected: { color: "var(--cs-danger)", label: "Disconnected" },
  simulation: { color: "var(--cs-accent)", label: "Simulation" },
};
const visual = STATUS_VISUAL[status];
const showPort = status === "connected";
---

<figure class="tuner-shell not-content">
  <div class="tuner-shell__frame">
    <header class="tuner-shell__header">
      <span class="tuner-shell__title">CANShift Tuner</span>
      <span class="tuner-shell__version">v{tunerVersion}</span>
      <span class="tuner-shell__spacer"></span>

      <span class="tuner-shell__status" aria-live="polite">
        <span
          class="tuner-shell__dot"
          aria-hidden="true"
          style={`background:${visual.color}; box-shadow:0 0 6px ${visual.color};`}
        ></span>
        <span class="tuner-shell__status-label">{visual.label}</span>
        {showPort && <span class="tuner-shell__port">{port}</span>}
      </span>

      <span class="tuner-shell__slot">
        <span class="tuner-shell__slot-label">FW</span>
        <span class="tuner-shell__slot-value">{firmwareVersion}</span>
      </span>

      <button type="button" class="tuner-shell__burn" disabled>Burn</button>
    </header>

    <div class="tuner-shell__body">
      <nav class="tuner-shell__sidebar" aria-label="Tuner mock navigation">
        {
          ENTRIES.map((entry) =>
            entry.kind === "divider" ? (
              <span class="tuner-shell__divider" aria-hidden="true" />
            ) : (
              <span
                class:list={[
                  "tuner-shell__nav-item",
                  entry.to === route && "is-active",
                ]}
              >
                <span class="tuner-shell__nav-icon" aria-hidden="true">
                  {entry.icon}
                </span>
                <span class="tuner-shell__nav-label">{entry.label}</span>
              </span>
            ),
          )
        }
      </nav>
      <div class="tuner-shell__main">
        <slot />
      </div>
    </div>
  </div>
</figure>

<style>
  .tuner-shell {
    margin: 1.5rem 0;
    container-type: inline-size;
  }

  .tuner-shell__frame {
    background: var(--cs-bg);
    color: var(--cs-text);
    border: 1px solid var(--cs-border);
    border-radius: 10px;
    overflow: hidden;
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-size: 14px;
    line-height: 1.5;
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.02) inset;
  }

  /* Header — mirrors canshift-tuner/src/components/Shell/Header.tsx */
  .tuner-shell__header {
    height: 40px;
    flex-shrink: 0;
    background: var(--cs-surface);
    border-bottom: 1px solid var(--cs-border);
    display: flex;
    align-items: center;
    padding: 0 14px;
    gap: 14px;
  }

  .tuner-shell__title {
    font-size: 14px;
    font-weight: 700;
    color: var(--cs-text);
  }

  .tuner-shell__version {
    font-size: 11px;
    color: var(--cs-text-dim);
    font-family: var(--sl-font-mono);
    letter-spacing: 0.04em;
  }

  .tuner-shell__spacer {
    flex: 1;
  }

  .tuner-shell__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--cs-text-dim);
  }

  .tuner-shell__status-label {
    color: var(--cs-text);
  }

  .tuner-shell__port {
    font-family: var(--sl-font-mono);
    color: var(--cs-text-muted);
  }

  .tuner-shell__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* FirmwareSlot mirror */
  .tuner-shell__slot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 8px;
    border: 1px solid var(--cs-border);
    border-radius: 4px;
    background: var(--cs-bg-inset);
    font-family: var(--sl-font-mono);
    font-size: 10px;
  }
  .tuner-shell__slot-label {
    color: var(--cs-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tuner-shell__slot-value {
    color: var(--cs-text);
  }

  /* Burn button — exact match: padding 5/14, font 11, weight 600, letter-spacing 0.04em, uppercase */
  .tuner-shell__burn {
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--cs-surface-2);
    color: var(--cs-text-dim);
    border: 1px solid var(--cs-border);
    cursor: not-allowed;
    opacity: 0.5;
    font-family: inherit;
  }

  .tuner-shell__body {
    display: flex;
    min-height: 320px;
  }

  /* Sidebar — exact: width 200, padding 8/0, item padding 8/16, fontSize 13, gap 10 */
  .tuner-shell__sidebar {
    width: 200px;
    flex-shrink: 0;
    background: var(--cs-surface);
    border-right: 1px solid var(--cs-border);
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    overflow-y: auto;
  }

  .tuner-shell__divider {
    height: 1px;
    margin: 8px 12px;
    background: var(--cs-border);
  }

  .tuner-shell__nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    font-size: 13px;
    color: var(--cs-text-dim);
    border-left: 3px solid transparent;
  }

  .tuner-shell__nav-item.is-active {
    color: var(--cs-text);
    background: var(--cs-surface-2);
    border-left-color: var(--cs-primary);
    font-weight: 600;
  }

  .tuner-shell__nav-icon {
    width: 16px;
    text-align: center;
    font-size: 13px;
    color: inherit;
  }

  .tuner-shell__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--cs-bg);
    min-height: 0;
  }

  @container (max-width: 720px) {
    .tuner-shell__sidebar {
      width: 56px;
    }
    .tuner-shell__nav-label,
    .tuner-shell__version,
    .tuner-shell__port,
    .tuner-shell__slot-label {
      display: none;
    }
  }
</style>
