---
import "./tuner-mock.css";

const ENTRIES = [
  { ts: "14:02:11.412", level: "INFO", scope: "bootloader", message: "splash up, fb 80 KB free" },
  { ts: "14:02:11.638", level: "INFO", scope: "fs", message: "SPIFFS mounted (1.4 MB, 87% free)" },
  { ts: "14:02:11.722", level: "SUCCESS", scope: "can", message: "tjA1051 up @ 500 kbit/s" },
  { ts: "14:02:11.840", level: "WARN", scope: "obd2", message: "pid 0x0B not supported by ECU, skipping" },
  { ts: "14:02:11.901", level: "SUCCESS", scope: "ui", message: "3 pages built in 96 ms" },
  { ts: "14:02:12.013", level: "ERROR", scope: "ble", message: "stack init failed (-3) — disabling" },
  { ts: "14:02:12.140", level: "INFO", scope: "tuner", message: "serial up, awaiting handshake" },
] as const;
---

<div class="tuner-screen tuner-logs">
  <header class="tuner-route-header tuner-logs__header">
    <div>
      <div class="tuner-route-header__title">Logs</div>
      <div class="tuner-route-header__subtitle">
        {ENTRIES.length} entries · {ENTRIES.length} total
      </div>
    </div>
    <div class="tuner-logs__toolbar">
      <button type="button" class="tuner-level-pill" data-level="info" data-active="true">info</button>
      <button type="button" class="tuner-level-pill" data-level="success" data-active="true">success</button>
      <button type="button" class="tuner-level-pill" data-level="warn" data-active="true">warn</button>
      <button type="button" class="tuner-level-pill" data-level="error" data-active="true">error</button>
      <label class="tuner-logs__verbose">
        <input type="checkbox" /> verbose
      </label>
      <span class="tuner-logs__divider" aria-hidden="true"></span>
      <button type="button" class="tuner-btn tuner-btn--outline tuner-logs__btn">Copy all</button>
      <button type="button" class="tuner-btn tuner-btn--outline tuner-logs__btn">Clear</button>
    </div>
  </header>

  <div class="tuner-logs__stream">
    {
      ENTRIES.map((e) => (
        <div class="tuner-logs__entry">
          <span class="tuner-logs__ts">{e.ts}</span>
          <span class="tuner-logs__level" data-level={e.level.toLowerCase()}>
            {e.level.padEnd(7)}
          </span>
          <span class="tuner-logs__scope">[{e.scope}]</span>
          <span class="tuner-logs__msg">{e.message}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tuner-logs__header { flex-wrap: wrap; }
  .tuner-logs__toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tuner-logs__verbose {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--cs-text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: 4px;
  }
  .tuner-logs__verbose input {
    accent-color: var(--cs-primary);
  }
  .tuner-logs__divider {
    width: 1px;
    height: 18px;
    background: var(--cs-border);
    margin: 0 4px;
  }
  .tuner-logs__btn {
    height: 30px;
    padding: 0 12px;
    font-size: 12px;
  }

  /* Stream: padding 12/28, mono 12/1.55 */
  .tuner-logs__stream {
    flex: 1;
    overflow-y: auto;
    padding: 12px 28px;
    font-family: var(--sl-font-mono);
    font-size: 12px;
    line-height: 1.55;
  }
  .tuner-logs__entry {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 2px 0;
  }
  .tuner-logs__ts {
    color: var(--cs-text-muted);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .tuner-logs__level {
    flex-shrink: 0;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: pre;
  }
  .tuner-logs__level[data-level="info"]    { color: var(--cs-text-dim); }
  .tuner-logs__level[data-level="success"] { color: var(--cs-success); }
  .tuner-logs__level[data-level="warn"]    { color: var(--cs-accent); }
  .tuner-logs__level[data-level="error"]   { color: var(--cs-danger); }
  .tuner-logs__scope { color: var(--cs-text-muted); flex-shrink: 0; }
  .tuner-logs__msg { color: var(--cs-text); flex: 1; }
</style>
