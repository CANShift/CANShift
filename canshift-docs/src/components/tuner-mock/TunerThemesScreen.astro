---
import "./tuner-mock.css";
---

<div class="tuner-screen">
  <div class="tuner-section-header">
    <h3>Themes</h3>
    <p>Day / night palettes applied to the dash. Live preview on the right.</p>
  </div>
  <div class="tuner-section-body">
    <div class="tuner-themes">
      <div class="tuner-themes__list">
        <button type="button" class="tuner-themes__card is-active" style="--c1:#121212;--c2:#FF4747;--c3:#FF8800;">
          <span class="tuner-themes__swatch"></span>
          <span class="tuner-themes__name">Night red</span>
          <span class="tuner-pill tuner-pill--success">Active</span>
        </button>
        <button type="button" class="tuner-themes__card" style="--c1:#0E1B2E;--c2:#3CC3FF;--c3:#FFFFFF;">
          <span class="tuner-themes__swatch"></span>
          <span class="tuner-themes__name">Night blue</span>
        </button>
        <button type="button" class="tuner-themes__card" style="--c1:#F5F0E8;--c2:#1E1E1E;--c3:#CC3333;">
          <span class="tuner-themes__swatch"></span>
          <span class="tuner-themes__name">Day paper</span>
        </button>
      </div>
      <div class="tuner-themes__preview">
        <span class="tuner-themes__preview-label">Preview</span>
        <div class="tuner-themes__preview-value">7 250</div>
        <div class="tuner-themes__preview-bar"></div>
        <div class="tuner-themes__preview-pills">
          <span>92°</span>
          <span>0.84</span>
          <span>3rd</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tuner-themes {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 14px;
  }
  .tuner-themes__list { display: flex; flex-direction: column; gap: 6px; }
  .tuner-themes__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-border);
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
    color: var(--cs-text-dim);
    font-size: 12px;
  }
  .tuner-themes__card.is-active {
    border-color: var(--cs-primary);
    color: var(--cs-text);
  }
  .tuner-themes__swatch {
    width: 36px;
    height: 24px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--c1) 0 50%, var(--c2) 50% 80%, var(--c3) 80% 100%);
    border: 1px solid var(--cs-border);
  }
  .tuner-themes__name { font-weight: 600; }

  .tuner-themes__preview {
    background: #121212;
    border: 1px solid var(--cs-border);
    border-radius: 6px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tuner-themes__preview-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--cs-text-muted);
  }
  .tuner-themes__preview-value {
    font-family: "Orbitron", system-ui, sans-serif;
    font-weight: 900;
    font-size: 32px;
    color: #ff4747;
    text-shadow: 0 0 12px rgba(255, 71, 71, 0.4);
  }
  .tuner-themes__preview-bar {
    height: 4px;
    background: linear-gradient(to right, #ff4747 78%, #292929 0);
    border-radius: 2px;
  }
  .tuner-themes__preview-pills {
    display: flex;
    gap: 8px;
    font-family: var(--sl-font-mono);
    color: #fff;
    font-size: 12px;
  }
  .tuner-themes__preview-pills span {
    background: #292929;
    border-radius: 4px;
    padding: 2px 8px;
  }
  @container (max-width: 640px) {
    .tuner-themes { grid-template-columns: 1fr; }
  }
</style>
