---
import "./tuner-mock.css";

interface Props {
  mode?: "day" | "night";
}
const { mode = "night" } = Astro.props;
---

<div class="tuner-screen tuner-themes">
  <div class="tuner-themes__content">
    <header class="tuner-themes__head">
      <div class="tuner-themes__title">Themes</div>
      <div class="tuner-themes__subtitle">
        Day / night palette state read from the device on connect. The active
        dashboard config decides per-page colours; this route flips the global
        mode the firmware uses to pick which palette to render.
      </div>
    </header>

    <div class="tuner-themes__status" data-variant={mode}>
      <div class="tuner-themes__icon">{mode === "day" ? "☀" : "☾"}</div>
      <div class="tuner-themes__details">
        <div class="tuner-themes__label">Current theme</div>
        <div class="tuner-themes__value">{mode === "day" ? "Day" : "Night"}</div>
        <div class="tuner-themes__hint">
          {
            mode === "day"
              ? "Bright palette: light background, dark text."
              : "Dark palette: black background, white text."
          }
        </div>
      </div>
    </div>

    <div class="tuner-themes__controls">
      <button type="button" class="tuner-btn tuner-btn--primary tuner-btn--lg">
        Toggle day / night
      </button>
      <div class="tuner-themes__row">
        <button
          type="button"
          class="tuner-btn tuner-btn--outline tuner-btn--lg"
          aria-disabled={mode === "day"}
        >Force Day</button>
        <button
          type="button"
          class="tuner-btn tuner-btn--outline tuner-btn--lg"
          aria-disabled={mode === "night"}
        >Force Night</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ThemesRoute container — centered, padding 32/28, max 560, gap 24 */
  .tuner-themes {
    align-items: flex-start;
    justify-content: center;
    padding: 32px 28px;
    overflow-y: auto;
  }
  .tuner-themes__content {
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .tuner-themes__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tuner-themes__title {
    font-size: 22px;
    font-weight: 700;
    color: var(--cs-text);
    letter-spacing: -0.01em;
  }
  .tuner-themes__subtitle {
    font-size: 13px;
    color: var(--cs-text-dim);
    line-height: 1.5;
  }

  /* ThemeStatusCard — padding 20/22, radius 10, day vs night palette */
  .tuner-themes__status {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
    border-radius: 10px;
    background: var(--cs-bg-inset);
    border: 1px solid var(--cs-border);
    color: var(--cs-text);
  }
  .tuner-themes__status[data-variant="day"] {
    background: hsl(45 90% 95%);
    border-color: hsl(45 70% 70%);
    color: hsl(45 50% 18%);
  }
  .tuner-themes__icon {
    font-size: 40px;
    line-height: 1;
  }
  .tuner-themes__details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tuner-themes__label {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .tuner-themes__value {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tuner-themes__hint {
    font-size: 12px;
    opacity: 0.75;
  }

  .tuner-themes__controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tuner-themes__row {
    display: flex;
    gap: 8px;
  }
</style>
