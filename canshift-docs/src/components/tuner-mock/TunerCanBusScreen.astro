---
import "./tuner-mock.css";

const FRAMES = [
  { id: "0x280", firstSeen: "00:03.412", lastSeen: "<1s", count: "1.2k", rate: "50 Hz", dlc: 8, payload: "4F 28 1C 00 00 00 00 00" },
  { id: "0x288", firstSeen: "00:03.432", lastSeen: "<1s", count: "1.2k", rate: "50 Hz", dlc: 8, payload: "00 5A 00 00 00 7D 00 00" },
  { id: "0x320", firstSeen: "00:03.440", lastSeen: "1s", count: "248", rate: "10 Hz", dlc: 8, payload: "00 00 00 00 00 00 00 00" },
  { id: "0x420", firstSeen: "00:03.452", lastSeen: "<1s", count: "2.1k", rate: "84 Hz", dlc: 8, payload: "69 00 00 00 7E 1A 00 00" },
  { id: "0x540", firstSeen: "00:03.460", lastSeen: "3s", count: "62", rate: "5 Hz", dlc: 8, payload: "00 00 00 00 00 00 00 00" },
];
---

<div class="tuner-screen">
  <header class="tuner-canbus__toolbar">
    <div class="tuner-canbus__controls">
      <button type="button" class="tuner-btn tuner-btn--destructive">Stop</button>
      <button type="button" class="tuner-btn tuner-btn--outline" disabled>Reset</button>
    </div>
    <div class="tuner-canbus__metrics">
      <div class="tuner-metric">
        <span class="tuner-metric__label">Frames</span>
        <span class="tuner-metric__value">12.4k</span>
      </div>
      <div class="tuner-metric">
        <span class="tuner-metric__label">Rate</span>
        <span class="tuner-metric__value">198 Hz</span>
      </div>
      <div class="tuner-metric">
        <span class="tuner-metric__label">Elapsed</span>
        <span class="tuner-metric__value">1m 04s</span>
      </div>
      <div class="tuner-metric">
        <span class="tuner-metric__label">Status</span>
        <span class="tuner-metric__value">Running</span>
      </div>
    </div>
  </header>

  <nav class="tuner-canbus__sort">
    <span class="tuner-canbus__sort-label">Sort by</span>
    <button type="button" class="tuner-canbus__sort-btn" data-active="true">ID</button>
    <button type="button" class="tuner-canbus__sort-btn">Last seen</button>
    <button type="button" class="tuner-canbus__sort-btn">Rate</button>
    <button type="button" class="tuner-canbus__sort-btn">Count</button>
  </nav>

  <div class="tuner-canbus__table-wrap">
    <table class="tuner-table tuner-canbus__table">
      <thead>
        <tr>
          <th>ID</th>
          <th class="num">First seen</th>
          <th class="num">Last seen</th>
          <th class="num">Count</th>
          <th class="num">Rate</th>
          <th class="center">DLC</th>
          <th>Last payload</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          FRAMES.map((f) => (
            <tr>
              <td>{f.id}</td>
              <td class="num dim">{f.firstSeen}</td>
              <td class="num dim">{f.lastSeen}</td>
              <td class="num">{f.count}</td>
              <td class="num">{f.rate}</td>
              <td class="num">{f.dlc}</td>
              <td>{f.payload}</td>
              <td>
                <button type="button" class="tuner-btn tuner-btn--outline tuner-canbus__promote">
                  Promote
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  /* CanScanToolbar.tsx — padding 12/20, bg surface, border-bottom */
  .tuner-canbus__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--cs-border);
    background: var(--cs-surface);
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  .tuner-canbus__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tuner-canbus__metrics {
    display: flex;
    align-items: center;
    gap: 18px;
    font-variant-numeric: tabular-nums;
  }

  /* Sort bar (gap 8, padding 8/20, border-bottom) */
  .tuner-canbus__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    border-bottom: 1px solid var(--cs-border);
    background: var(--cs-bg);
    font-size: 11px;
    flex-shrink: 0;
  }
  .tuner-canbus__sort-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cs-text-muted);
  }
  .tuner-canbus__sort-btn {
    background: transparent;
    border: 1px solid var(--cs-border);
    color: var(--cs-text-muted);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-family: inherit;
    cursor: default;
  }
  .tuner-canbus__sort-btn[data-active="true"] {
    color: var(--cs-text);
    border-color: var(--cs-primary);
    background: color-mix(in srgb, var(--cs-primary) 10%, transparent);
  }

  .tuner-canbus__table-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 0 20px 20px;
  }
  .tuner-canbus__table { font-size: 12px; }
  .tuner-canbus__table th.center,
  .tuner-canbus__table td.num {
    text-align: right;
  }
  .tuner-canbus__table th.center { text-align: center; }
  .tuner-canbus__promote {
    height: 26px;
    padding: 0 10px;
    font-size: 11px;
  }
</style>
