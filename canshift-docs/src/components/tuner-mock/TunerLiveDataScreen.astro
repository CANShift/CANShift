---
import "./tuner-mock.css";

const ROWS = [
  { name: "ENGINE_RPM", value: "4280.0", min: 0, max: 7500, unit: "rpm", age: "<1s", pct: 57 },
  { name: "COOLANT_TEMP", value: "92.0", min: -40, max: 215, unit: "°C", age: "<1s", pct: 51 },
  { name: "BOOST_KPA", value: "184.0", min: 0, max: 300, unit: "kPa", age: "<1s", pct: 61 },
  { name: "LAMBDA", value: "0.9", min: 0.6, max: 1.4, unit: "λ", age: "1s ago", pct: 37 },
  { name: "OIL_PRESSURE", value: "4.1", min: 0, max: 10, unit: "bar", age: "<1s", pct: 41 },
  { name: "GEAR", value: "3.0", min: 0, max: 6, unit: "—", age: "2s ago", pct: 50 },
];
---

<div class="tuner-screen">
  <header class="tuner-route-header">
    <div>
      <div class="tuner-route-header__title">Live Data</div>
      <div class="tuner-route-header__subtitle">
        {ROWS.length} signals · <span class="tuner-source-badge tuner-source-badge--live">Live</span>
      </div>
    </div>
    <div class="tuner-route-header__toolbar">
      <input
        type="search"
        class="tuner-filter"
        placeholder="Filter by name or unit"
        readonly
      />
      <button type="button" class="tuner-btn tuner-btn--outline">Export CSV</button>
    </div>
  </header>

  <div class="tuner-table-wrap">
    <table class="tuner-table">
      <thead>
        <tr>
          <th>Signal</th>
          <th class="num">Value</th>
          <th class="num">Range</th>
          <th>Unit</th>
          <th class="num">Last update</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((r) => (
            <tr>
              <td>{r.name}</td>
              <td class="num">{r.value}</td>
              <td class="num">
                <div class="tuner-range">
                  <div class="tuner-range__track">
                    <div class="tuner-range__fill" style={`width:${r.pct}%`} />
                  </div>
                  <span class="tuner-range__label">{r.min}–{r.max}</span>
                </div>
              </td>
              <td class="dim">{r.unit}</td>
              <td class="num dim">{r.age}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
