---
import "./tuner-mock.css";

const PAGES = [
  { id: "main", label: "Main", isDefault: true, selected: true },
  { id: "engine", label: "Engine", isDefault: false, selected: false },
  { id: "track", label: "Track", isDefault: false, selected: false },
];
---

<div class="tuner-screen tuner-editor">
  <aside class="tuner-editor__pages">
    <div class="tuner-editor__pages-head">
      <span class="tuner-editor__pages-label">Pages</span>
      <span class="tuner-editor__pages-count">3/5</span>
    </div>
    {
      PAGES.map((p) => (
        <div
          class:list={[
            "tuner-editor__thumb-wrap",
            p.selected && "is-selected",
          ]}
        >
          <div class="tuner-editor__thumb">
            <span class="tuner-editor__thumb-star" data-default={p.isDefault}>
              {p.isDefault ? "★" : "☆"}
            </span>
            <span class="tuner-editor__thumb-x">×</span>
            <div class="tuner-editor__thumb-body" data-page={p.id}>
              <span class="tuner-editor__thumb-rpm">4 280</span>
              <span class="tuner-editor__thumb-tiles">
                <span>92°</span><span>0.84</span><span>3</span>
              </span>
            </div>
          </div>
          <div class="tuner-editor__thumb-label">{p.label}</div>
        </div>
      ))
    }
    <button type="button" class="tuner-editor__add-page">+ Add page</button>
  </aside>

  <div class="tuner-editor__canvas">
    <div class="tuner-editor__viewport">
      <div class="tuner-editor__topbar">
        <span class="tuner-editor__top-dot" style="background: var(--cs-success);"></span>
        <span class="tuner-editor__top-dot" style="background: var(--cs-success);"></span>
        <span class="tuner-editor__top-dot" style="background: var(--cs-text-muted);"></span>
      </div>
      <div class="tuner-editor__grid">
        <div class="tuner-editor__widget tuner-editor__widget--gauge is-selected" style="grid-area: 1 / 1 / span 2 / span 2;">
          <span class="tuner-editor__w-label">RPM</span>
          <span class="tuner-editor__w-value">4 280</span>
          <span class="tuner-editor__w-bar" style="--p:62%"></span>
        </div>
        <div class="tuner-editor__widget" style="grid-area: 1 / 3;">
          <span class="tuner-editor__w-label">Coolant</span>
          <span class="tuner-editor__w-value tuner-editor__w-value--sm">92°</span>
        </div>
        <div class="tuner-editor__widget" style="grid-area: 1 / 4;">
          <span class="tuner-editor__w-label">Boost</span>
          <span class="tuner-editor__w-value tuner-editor__w-value--sm">0.84</span>
        </div>
        <div class="tuner-editor__widget" style="grid-area: 2 / 3 / span 1 / span 2;">
          <span class="tuner-editor__w-label">Gear</span>
          <span class="tuner-editor__w-value">3</span>
        </div>
      </div>
    </div>
  </div>

  <aside class="tuner-editor__inspector">
    <div class="tuner-editor__tabs" role="tablist">
      <button type="button" class="tuner-editor__tab" data-active="true">Properties</button>
      <button type="button" class="tuner-editor__tab">Signals</button>
    </div>
    <div class="tuner-editor__panel">
      <div class="tuner-editor__field">
        <label>Widget</label>
        <span>RPM gauge</span>
      </div>
      <div class="tuner-editor__field">
        <label>Signal</label>
        <span class="mono">ENGINE_RPM</span>
      </div>
      <div class="tuner-editor__field">
        <label>Min</label>
        <span class="mono">0</span>
      </div>
      <div class="tuner-editor__field">
        <label>Max</label>
        <span class="mono">7500</span>
      </div>
      <div class="tuner-editor__field">
        <label>Redline</label>
        <span class="mono" style="color: var(--cs-primary);">6800</span>
      </div>
      <div class="tuner-editor__field">
        <label>Decimals</label>
        <span class="mono">0</span>
      </div>
    </div>
  </aside>
</div>

<style>
  .tuner-editor {
    flex-direction: row;
  }

  /* Pages aside — EditorRoute.tsx: width 152, bg #161616, border-right #222 */
  .tuner-editor__pages {
    width: 152px;
    flex-shrink: 0;
    background: #161616;
    border-right: 1px solid #222222;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 8px;
  }
  .tuner-editor__pages-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .tuner-editor__pages-label {
    font-size: 10px;
    color: #aaaaaa;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .tuner-editor__pages-count {
    font-size: 10px;
    color: #666;
    font-family: var(--sl-font-mono);
  }
  .tuner-editor__thumb-wrap {
    margin-bottom: 8px;
  }
  .tuner-editor__thumb {
    border: 2px solid #2a2a2a;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4 / 3;
    background: #000;
  }
  .tuner-editor__thumb-wrap.is-selected .tuner-editor__thumb {
    border-color: #ffffff;
    box-shadow: 0 0 0 1px #ffffff22;
  }
  .tuner-editor__thumb-star,
  .tuner-editor__thumb-x {
    position: absolute;
    top: 2px;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #00000055;
    border-radius: 3px;
    font-size: 12px;
    line-height: 1;
  }
  .tuner-editor__thumb-star {
    left: 2px;
    color: #666;
  }
  .tuner-editor__thumb-star[data-default="true"] {
    color: #ffaa00;
    background: #000000aa;
  }
  .tuner-editor__thumb-x {
    right: 2px;
    color: #888;
    font-size: 14px;
  }
  .tuner-editor__thumb-body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px;
  }
  .tuner-editor__thumb-rpm {
    font-family: "Orbitron", system-ui, sans-serif;
    font-weight: 900;
    font-size: 14px;
    color: #ff4747;
  }
  .tuner-editor__thumb-tiles {
    display: flex;
    gap: 3px;
    font-family: var(--sl-font-mono);
    font-size: 8px;
    color: #fff;
  }
  .tuner-editor__thumb-tiles span {
    background: #292929;
    border-radius: 2px;
    padding: 1px 3px;
  }
  .tuner-editor__thumb-label {
    margin-top: 2px;
    font-size: 10px;
    color: #aaaaaa;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .tuner-editor__add-page {
    margin-top: 4px;
    background: transparent;
    border: 1px dashed #2a2a2a;
    color: #666;
    border-radius: 4px;
    padding: 6px;
    font-size: 11px;
    cursor: default;
    font-family: inherit;
  }

  /* Canvas — center area */
  .tuner-editor__canvas {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: var(--cs-bg-inset);
    overflow: hidden;
  }
  .tuner-editor__viewport {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 3;
    background: #000;
    border: 1px solid var(--cs-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .tuner-editor__topbar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 18px;
    padding: 0 8px;
    background: #0a0a0a;
    border-bottom: 1px solid #1a1a1a;
  }
  .tuner-editor__top-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .tuner-editor__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 4px;
    padding: 8px;
  }
  .tuner-editor__widget {
    background: #111;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 4px 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2px;
  }
  .tuner-editor__widget.is-selected {
    border-color: #ffffff;
    box-shadow: 0 0 0 1px #ffffff33;
  }
  .tuner-editor__w-label {
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
  }
  .tuner-editor__w-value {
    font-family: "Orbitron", system-ui, sans-serif;
    font-weight: 900;
    font-size: 22px;
    color: #ff4747;
  }
  .tuner-editor__w-value--sm {
    font-size: 14px;
    color: #fff;
    font-weight: 700;
  }
  .tuner-editor__w-bar {
    width: 80%;
    height: 2px;
    background: linear-gradient(to right, #ff4747 var(--p, 50%), #1a1a1a 0);
  }

  /* Inspector — RightSidebar.tsx: width 220, bg #161616, border-left #222 */
  .tuner-editor__inspector {
    width: 220px;
    flex-shrink: 0;
    background: #161616;
    border-left: 1px solid #222222;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .tuner-editor__tabs {
    display: flex;
    border-bottom: 1px solid #222;
  }
  .tuner-editor__tab {
    flex: 1;
    padding: 8px 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    color: #777;
    cursor: default;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: inherit;
  }
  .tuner-editor__tab[data-active="true"] {
    background: #1f1f1f;
    color: #fff;
    border-bottom-color: #fff;
    font-weight: 600;
  }
  .tuner-editor__panel {
    flex: 1;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
  }
  .tuner-editor__field {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }
  .tuner-editor__field label {
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10px;
  }
  .tuner-editor__field span { color: var(--cs-text); }
  .tuner-editor__field .mono { font-family: var(--sl-font-mono); }

  @container (max-width: 820px) {
    .tuner-editor {
      flex-direction: column;
    }
    .tuner-editor__pages {
      width: 100%;
      max-height: 100px;
      flex-direction: row;
      border-right: 0;
      border-bottom: 1px solid #222;
      overflow-x: auto;
    }
    .tuner-editor__thumb-wrap { min-width: 100px; }
    .tuner-editor__inspector {
      width: 100%;
      border-left: 0;
      border-top: 1px solid #222;
    }
  }
</style>
