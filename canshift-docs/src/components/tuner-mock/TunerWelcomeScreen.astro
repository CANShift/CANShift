---
interface Props {
  variant?: "connect" | "connected";
}
const { variant = "connect" } = Astro.props;
---

<div class="tuner-screen tuner-welcome">
  <div class="tuner-welcome__hero">
    <span class="tuner-welcome__mark">⚡</span>
    <h2 class="tuner-welcome__title">CANShift</h2>
    <p class="tuner-welcome__tagline">
      Open dashboard for ESP32. Plug your dash, hit Connect, edit live.
    </p>
    {
      variant === "connect" ? (
        <button type="button" class="tuner-welcome__cta">
          Connect device
        </button>
      ) : (
        <div class="tuner-welcome__row">
          <span class="tuner-pill tuner-pill--success">● Connected</span>
          <span class="tuner-pill">USB JTAG/serial debug unit</span>
        </div>
      )
    }
  </div>
  <ul class="tuner-welcome__hints">
    <li>Press <kbd>Cmd</kbd>+<kbd>S</kbd> to Burn</li>
    <li>The dash auto-reconnects after a reboot</li>
    <li>Use Simulation mode without hardware</li>
  </ul>
</div>

<style>
  .tuner-welcome {
    display: grid;
    place-items: center;
    padding: 28px 24px;
    gap: 24px;
    text-align: center;
  }
  .tuner-welcome__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .tuner-welcome__mark {
    font-size: 36px;
    color: var(--cs-primary);
    text-shadow: 0 0 18px rgba(255, 71, 71, 0.4);
  }
  .tuner-welcome__title {
    font-family: "Orbitron", system-ui, sans-serif;
    font-weight: 900;
    font-size: 26px;
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cs-text);
  }
  .tuner-welcome__tagline {
    color: var(--cs-text-dim);
    font-size: 12px;
    max-width: 340px;
    margin: 0;
  }
  .tuner-welcome__cta {
    margin-top: 4px;
    background: var(--cs-primary);
    color: var(--cs-primary-foreground);
    border: 1px solid var(--cs-primary);
    border-radius: 6px;
    padding: 7px 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 1px 6px rgba(255, 71, 71, 0.32);
  }
  .tuner-welcome__row {
    display: flex;
    gap: 8px;
  }
  .tuner-welcome__hints {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--cs-text-muted);
    font-size: 11px;
  }
  .tuner-welcome__hints li {
    background: var(--cs-surface);
    border: 1px solid var(--cs-border);
    border-radius: 4px;
    padding: 4px 8px;
  }
  .tuner-welcome__hints kbd {
    font-family: var(--sl-font-mono);
    background: var(--cs-surface-2);
    border: 1px solid var(--cs-border);
    border-radius: 3px;
    padding: 0 4px;
    font-size: 10px;
    color: var(--cs-text);
  }
</style>
